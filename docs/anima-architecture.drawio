        <!-- cards: Sensors -->
        <mxCell id="7" value="Sensors&#xa;&#xa;retina grid (48) &#183; proprioception (8)&#xa;smell (optional, 6 channels)&#xa;&#xa;senses the world each beat" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e9f2fc;strokeColor=#7aa6d6;verticalAlign=top;fontSize=12;fontStyle=1;strokeWidth=1.8;" vertex="1" parent="1">
