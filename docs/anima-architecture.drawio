        </mxCell>
        <!-- Brain -->
        <mxCell id="8" value="Brain &#183; spiking LIF network&#xa;&#xa;inputs (poisson) &#8594; internal pool &#8594; 12 motor outputs&#xa;internal pool 40 / 128 / 256&#xa;STDP + structural plasticity&#xa;&#xa;rewires itself: no hand-designed internals" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef1f5;strokeColor=#8b98a8;verticalAlign=top;fontSize=12;fontStyle=1;strokeWidth=1.8;" vertex="1" parent="1">
          <mxGeometry x="40" y="256" width="300" height="152" as="geometry" />
        </mxCell>
        <!-- Home -->
        <mxCell id="9" value="Home / rest (optional 2nd drive)&#xa;&#xa;nest landmark · stamina recovery&#xa;return to rest and recover" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecf6ee;strokeColor=#66a87a;verticalAlign=top;fontSize=12;fontStyle=1;strokeWidth=1.8;" vertex="1" parent="1">
          <mxGeometry x="40" y="426" width="300" height="96" as="geometry" />
        </mxCell>
        <!-- World -->
        <mxCell id="10" value="3D world&#xa;&#xa;body · position, heading, pitch, velocity&#xa;arena 100 x 100 · gravity · ground&#xa;food patches (+30 energy)&#xa;energy tank, death at zero&#xa;&#xa;world steps once per beat · the source of reward" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf6f0;strokeColor=#5fb08a;verticalAlign=top;fontSize=12;fontStyle=1;strokeWidth=1.8;" vertex="1" parent="1">
          <mxGeometry x="400" y="130" width="304" height="176" as="geometry" />
        </mxCell>
        <!-- Evolution -->
        <mxCell id="11" value="Evolution · genetic algorithm&#xa;&#xa;4 creatures per generation&#xa;score = fitness (food + survival)&#xa;best breed · mutations · next generation&#xa;&#xa;selection acts across generations" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3eefb;strokeColor=#8a6fb5;verticalAlign=top;fontSize=12;fontStyle=1;strokeWidth=1.8;" vertex="1" parent="1">
          <mxGeometry x="758" y="130" width="328" height="142" as="geometry" />
        </mxCell>
        <!-- Determinism -->
        <mxCell id="12" value="Determinism · control layer&#xa;&#xa;seeded randomness (same seed &#8594; same run)&#xa;env-gated switches, frozen identity&#xa;&#xa;makes every result re-runnable" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9a227;dashed=1;verticalAlign=top;fontSize=12;fontStyle=1;strokeWidth=1.8;" vertex="1" parent="1">
