\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {The persistent-state information bottleneck.} The substrate's automatic compression cascade: afferent structure (persistent, selective) \(\to \) instantaneous spikes (activity) \(\to \) windowed counts (stimulus-locked, not retained) \(\to \) cumulative counts (the slow integrator \(u\)) \(\to \) intrinsic scalar \(u\) (persistent but information-poor; §\ref  {sec:u}). Each arrow is a lossy compression performed by the substrate's own dynamics.\relax }}{11}{figure.caption.21}\protected@file@percent }
\newlabel{fig:ladder}{{3}{11}{\textbf {The persistent-state information bottleneck.} The substrate's automatic compression cascade: afferent structure (persistent, selective) \(\to \) instantaneous spikes (activity) \(\to \) windowed counts (stimulus-locked, not retained) \(\to \) cumulative counts (the slow integrator \(u\)) \(\to \) intrinsic scalar \(u\) (persistent but information-poor; §\ref {sec:u}). Each arrow is a lossy compression performed by the substrate's own dynamics.\relax }{figure.caption.21}{}}
